{
  "name": "livexface",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for LiveXFace — Face Recognition as a Service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
