    "prepare": "tsc"
  },
  "keywords": [
    "face-recognition",
    "biometrics",
    "api",
    "sdk",
    "livexface"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livexface/livexface-js.git"
  },
  "homepage": "https://livexface.com",
  "bugs": {
    "url": "https://github.com/livexface/livexface-js/issues"
  },
  "author": "LiveXFace",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
